# API base URL used by the dashboard.
# Default `/api/v1` uses the Vite dev proxy (see vite.config.ts) and avoids CORS
# in local development. Point this at the absolute backend URL when hosting the
# dashboard separately, e.g. http://127.0.0.1:8000/api/v1, and add the dashboard
# origin to CORS_ALLOWED_ORIGINS on the backend.
VITE_API_BASE_URL=/api/v1
