# Project Yasmina — staging environment template.
#
# Copy to /opt/yasmina/staging/.env.staging on the VPS, replace every
# REPLACE_WITH value, then chmod 600. Never commit the real file.
#
# Generate secrets with:
#   openssl rand -hex 32
#   openssl rand -base64 32
#   ssh-keygen -t ed25519 -f yasmina-staging -C yasmina-staging-deploy

APP_ENV=staging
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_TIMEZONE=Europe/Berlin
APP_SECRET_KEY=REPLACE_WITH_FERNET_COMPATIBLE_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
PASSWORD_MIN_LENGTH=12

POSTGRES_USER=yasmina
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=yasmina
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yasmina:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/yasmina

MINIO_ROOT_USER=yasmina-minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=yasmina-minio
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=yasmina
MINIO_SECURE=false
BACKUP_BUCKET=yasmina-backups

REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
REDIS_TIMEOUT_SECONDS=2
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_FAIL_OPEN=true

REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_PATH=/api/v1/auth
CORS_ALLOWED_ORIGINS=https://staging.yasmina.bayerclean.net
TRUST_PROXY_HEADERS=true

# Server-side approval signing key (64 hex characters or PEM). Generate with
# python -m src.admin generate-approval-key; it never leaves the VPS.
ED25519_APPROVAL_PRIVATE_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
# Public half; derived from the private key when left empty.
ED25519_APPROVAL_PUBLIC_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
APPROVAL_SIGNATURE_REQUIRED=true

# ERPNext sandbox connection. Use a real sandbox URL/key/secret for P7.2 validation.
ERPNEXT_BASE_URL=REPLACE_WITH_ERPNEXT_SANDBOX_URL
ERPNEXT_API_KEY=REPLACE_WITH_ERPNEXT_API_KEY
ERPNEXT_API_SECRET=REPLACE_WITH_ERPNEXT_API_SECRET
ERPNEXT_COMPANY=Yasmina
ERPNEXT_ITEM_GROUP=Products
ERPNEXT_SELLING_PRICE_LIST=Standard Selling
ERPNEXT_QUOTATION_SERIES=SAL-QTN-.YYYY.-
QUOTATION_SYNC_MAX_ATTEMPTS=6
QUOTATION_SYNC_BACKOFF_SECONDS=60
QUOTATION_SYNC_BATCH_SIZE=10

# Optional alerting.
TELEGRAM_BOT_TOKEN=
# Destination for worker alerts (failed runs, exhausted ERPNext jobs).
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# SMTP password-reset delivery (optional; Telegram remains the fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Yasmina
SMTP_STARTTLS=true
SMTP_SSL=false

# Antivirus for uploaded tender documents (fail-closed when unreachable).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# LLM extraction/matching. Leave DEEPSEEK_ENABLED=false to run deterministically.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Encrypted backup sidecar settings (the staging stack itself has no sidecar; the
# CLI `python -m src.admin backup-postgres` reads these values).
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_FROM_generate-backup-key
BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=1800
PG_DUMP_BINARY=pg_dump

# Portal catalogue and scheduler.
PORTAL_CONFIG_FILE=/app/config/portals.yaml
SCRAPER_SCHEDULE_CRON="0 2 * * *"
WORKER_RUN_RETENTION_DAYS=90
SCRAPER_MAX_CONCURRENT_PORTALS=6
SCRAPER_DOMAIN_LOCK_TTL_SECONDS=1800
SCRAPER_PREFER_API=true

# Updated by scripts/deploy_staging.sh after a successful rollout.
IMAGE_TAG=REPLACE_WITH_COMMIT_SHA
REGISTRY=ghcr.io
IMAGE_OWNER=hamdyfouad
