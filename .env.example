# ---------------------------------------------------------------------------
# Project Yasmina — environment template
# Copy to `.env` (never commit) and replace every `change-me` placeholder.
# The database/MinIO values below are local-development defaults and match
# docker-compose.yml; change them for shared, staging or production systems.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local                       # local | test | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_TIMEZONE=Europe/Berlin
APP_SECRET_KEY=change-me-app-secret

# --- API / JWT -------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-change-me-now
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=yasmina
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=change-me-admin-password
MAX_UPLOAD_SIZE_MB=25

# --- Invoice seller (used by ZUGFeRD/XRechnung) ---------------------------
COMPANY_NAME=Yasmina GmbH
COMPANY_STREET=Hauptstr. 1
COMPANY_CITY=Berlin
COMPANY_POSTAL_CODE=10115
COMPANY_COUNTRY_CODE=DE
COMPANY_VAT_ID=DE123456789
COMPANY_IBAN=DE89370400440532013000
COMPANY_EMAIL=rechnung@yasmina.example

# --- PostgreSQL / pgvector -------------------------------------------------
POSTGRES_USER=yasmina
POSTGRES_PASSWORD=yasmina
POSTGRES_DB=yasmina
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional explicit override. When empty, the URL is assembled from POSTGRES_*.
# DATABASE_URL=postgresql+asyncpg://yasmina:yasmina@localhost:5432/yasmina
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# --- MinIO -----------------------------------------------------------------
# Consumed by the MinIO container ...
MINIO_ROOT_USER=yasmina-minio
MINIO_ROOT_PASSWORD=yasmina-minio-secret
# ... and by the application (keep both pairs in sync).
MINIO_ACCESS_KEY=yasmina-minio
MINIO_SECRET_KEY=yasmina-minio-secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=yasmina
MINIO_SECURE=false

# --- ClamAV ----------------------------------------------------------------
# First container start downloads the signature database and can take minutes.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Startup checks --------------------------------------------------------
PREFLIGHT_TIMEOUT_SECONDS=5

# --- DeepSeek / LLM extraction --------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TEMPERATURE=0.0
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# --- n8n automation --------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-n8n-encryption
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_HMAC_SECRET=change-me-n8n-hmac

# --- ERPNext ---------------------------------------------------------------
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=Yasmina

# --- HITL approval (Ed25519) ----------------------------------------------
# 32-byte Ed25519 public key as 64 lowercase hex characters. Leave empty for
# local development; production refuses to approve offers without it.
ED25519_APPROVAL_PUBLIC_KEY=
APPROVAL_SIGNATURE_REQUIRED=true

# --- Pricing / offers ------------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_VAT_RATE=0.19
DEFAULT_MARGIN_RATE=0.15
OFFER_VALIDITY_DAYS=30

# --- Storage / exports -----------------------------------------------------
GAEB_EXPORT_DIR=var/exports/gaeb
AUDIT_HASH_ALGORITHM=sha256
