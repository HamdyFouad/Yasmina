# ---------------------------------------------------------------------------
# Project Yasmina — environment template
# Copy to `.env` (never commit) and replace every `change-me` placeholder.
# The database/MinIO values below are local-development defaults and match
# docker-compose.yml; change them for shared, staging or production systems.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=local                       # local | test | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
APP_TIMEZONE=Europe/Berlin
APP_SECRET_KEY=change-me-app-secret

# --- API / JWT / identity --------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-change-me-now
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ISSUER=yasmina
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=change-me-admin-password
PASSWORD_MIN_LENGTH=12
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Refresh token travels in an HttpOnly cookie (never in JSON).
REFRESH_COOKIE_NAME=yasmina_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_PATH=/api/v1/auth
MAX_UPLOAD_SIZE_MB=25
# Browser origins allowed to call the API (operations dashboard)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MFA / token maintenance ----------------------------------------------
MFA_ISSUER=Yasmina
MFA_TOTP_INTERVAL_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1
AUTH_TOKEN_RETENTION_DAYS=7

# --- API rate limiting -----------------------------------------------------
RATE_LIMIT_ENABLED=true
# auto: Redis when REDIS_URL is set, otherwise the in-process bucket
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_BUSINESS_PER_MINUTE=300
# Shared distributed bucket, required in production
REDIS_URL=
REDIS_TIMEOUT_SECONDS=2
# Only enable behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# json (production default) or text for local terminals
LOG_FORMAT=json
METRICS_ENABLED=true

# --- Encrypted PostgreSQL backups -----------------------------------------
# Generate with: python -m src.admin generate-backup-key
BACKUP_BUCKET=yasmina-backups
BACKUP_PREFIX=postgres
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=1800
PG_DUMP_BINARY=pg_dump

# --- Invoice seller (used by ZUGFeRD/XRechnung) ---------------------------
COMPANY_NAME=BayerClean
COMPANY_STREET=Reithmayrstraße 52
COMPANY_CITY=Regensburg
COMPANY_POSTAL_CODE=93055
COMPANY_COUNTRY_CODE=DE
COMPANY_VAT_ID=DE123456789
COMPANY_IBAN=DE89370400440532013000
COMPANY_EMAIL=rechnung@bayerclean.de
COMPANY_PHONE=+49 941 123456

# --- PostgreSQL / pgvector -------------------------------------------------
POSTGRES_USER=yasmina
POSTGRES_PASSWORD=yasmina
POSTGRES_DB=yasmina
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional explicit override. When empty, the URL is assembled from POSTGRES_*.
# DATABASE_URL=postgresql+asyncpg://yasmina:yasmina@localhost:5432/yasmina
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# --- MinIO -----------------------------------------------------------------
# Consumed by the MinIO container ...
MINIO_ROOT_USER=yasmina-minio
MINIO_ROOT_PASSWORD=yasmina-minio-secret
# ... and by the application (keep both pairs in sync).
MINIO_ACCESS_KEY=yasmina-minio
MINIO_SECRET_KEY=yasmina-minio-secret
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=yasmina
MINIO_SECURE=false

# --- ClamAV ----------------------------------------------------------------
# First container start downloads the signature database and can take minutes.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Startup checks --------------------------------------------------------
PREFLIGHT_TIMEOUT_SECONDS=5

# --- Portal scrapers -------------------------------------------------------
# Compliance: robots.txt is always checked; 401/403/429/5xx fail closed.
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF_SECONDS=1.0
SCRAPER_ROBOTS_CACHE_SECONDS=3600
SCRAPER_MAX_PAGES=5
SCRAPER_ARCHIVE_RAW=true
SCRAPER_ARCHIVE_PREFIX=scrapers
# Download PDF/GAEB attachments from detail pages into MinIO.
SCRAPER_HARVEST_ATTACHMENTS=true
SCRAPER_MAX_ATTACHMENTS=10
SCRAPER_MAX_ATTACHMENT_MB=25
# Five-field cron schedule in APP_TIMEZONE. Default: daily at 02:00.
SCRAPER_SCHEDULE_CRON="0 2 * * *"
# Optional JSON array. Empty uses the built-in rotating pool.
SCRAPER_USER_AGENTS=[]

# --- DeepSeek / LLM extraction --------------------------------------------
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TEMPERATURE=0.0
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# Optional OpenAI-compatible embeddings endpoint. Falls back to DEEPSEEK_BASE_URL
# and DEEPSEEK_API_KEY when omitted.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BACKOFF_SECONDS=1.0

# --- n8n automation --------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-n8n-encryption
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_HMAC_SECRET=change-me-n8n-hmac
N8N_RFQ_WEBHOOK_PATH=/webhook/yasmina/rfq
# Absolute URL n8n calls back with supplier quotes.
N8N_CALLBACK_URL=http://localhost:8000/api/v1/integrations/n8n/supplier-quotes
N8N_TIMEOUT_SECONDS=10
N8N_MAX_RETRIES=2
N8N_RETRY_BACKOFF_SECONDS=0.5
N8N_CALLBACK_MAX_AGE_SECONDS=300

# --- Telegram alerting -----------------------------------------------------
# Optional. Alerts are skipped when the token or chat id is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=2
TELEGRAM_RETRY_BACKOFF_SECONDS=0.5

# --- ERPNext ---------------------------------------------------------------
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=Yasmina
ERPNEXT_ITEM_GROUP=Products
ERPNEXT_SELLING_PRICE_LIST=Standard Selling
ERPNEXT_QUOTATION_SERIES=SAL-QTN-.YYYY.-
ERPNEXT_TIMEOUT_SECONDS=10
ERPNEXT_MAX_RETRIES=2
ERPNEXT_RETRY_BACKOFF_SECONDS=0.5

# --- HITL approval (Ed25519) ----------------------------------------------
# 32-byte Ed25519 public key as 64 lowercase hex characters. Leave empty for
# local development; production refuses to approve offers without it.
ED25519_APPROVAL_PUBLIC_KEY=
APPROVAL_SIGNATURE_REQUIRED=true

# --- Pricing / offers ------------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_VAT_RATE=0.19
DEFAULT_MARGIN_RATE=0.15
OFFER_VALIDITY_DAYS=30

# --- Storage / exports -----------------------------------------------------
GAEB_EXPORT_DIR=var/exports/gaeb
AUDIT_HASH_ALGORITHM=sha256
