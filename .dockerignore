# Keep the production build context minimal and free of secrets.
.git
.github
.gitignore
.dockerignore
.env
.env.*
!.env.example
!.env.prod.example

__pycache__/
*.py[cod]
*.egg-info/
.venv/
.deps/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

tests/
docs/
scripts/
var/
*.log
*.sqlite3

docker-compose*.yml

# Frontend dependencies and generated assets are rebuilt inside the image.
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
