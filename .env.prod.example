# Project Yasmina — production environment template.
#
#   cp .env.prod.example .env.prod
#   # replace every change-me value, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Never commit the filled-in .env.prod.

# --- Application -----------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_TIMEZONE=Europe/Berlin
APP_SECRET_KEY=change-me-app-secret-at-least-32-characters
API_HOST_PORT=8000

# --- Authentication --------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
JWT_ISSUER=yasmina
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=change-me-admin-password
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
# Refresh token cookie: enable Secure when served over HTTPS.
REFRESH_COOKIE_NAME=yasmina_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_PATH=/api/v1/auth
MFA_ISSUER=Yasmina
MFA_TOTP_INTERVAL_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_TOTP_WINDOW=1

# --- HITL approval ---------------------------------------------------------
# 64 lowercase hex characters (32-byte Ed25519 public key). Required in production.
ED25519_APPROVAL_PUBLIC_KEY=change-me-64-lowercase-hex-characters
APPROVAL_SIGNATURE_REQUIRED=true

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=yasmina
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=yasmina
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yasmina:change-me-postgres-password@postgres:5432/yasmina

# --- MinIO -----------------------------------------------------------------
MINIO_ROOT_USER=yasmina-minio
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=yasmina-minio
MINIO_SECRET_KEY=change-me-minio-root-password
MINIO_BUCKET=yasmina
MINIO_SECURE=false
BACKUP_BUCKET=yasmina-backups

# --- API rate limiting (distributed via Redis) -----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_BUSINESS_PER_MINUTE=300
# Only enable when the API is behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=true
# Browser origin of the operations dashboard (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://ops.example.com
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
REDIS_TIMEOUT_SECONDS=2

# --- Portal scrapers -------------------------------------------------------
PORTAL_CONFIG_FILE=config/portals.yaml
SCRAPER_SCHEDULE_CRON="0 2 * * *"
SCRAPER_MAX_CONCURRENT_PORTALS=6
SCRAPER_DOMAIN_LOCK_TTL_SECONDS=1800
SCRAPER_PREFER_API=true

# --- ClamAV ----------------------------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# --- Encrypted backups -----------------------------------------------------
# Generate with: python -m src.admin generate-backup-key
BACKUP_ENCRYPTION_KEY=change-me-fernet-key
BACKUP_PREFIX=postgres
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_INTERVAL_SECONDS=86400
PG_DUMP_BINARY=pg_dump

# --- Outbound integrations (optional) --------------------------------------
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
QUOTATION_SYNC_MAX_ATTEMPTS=6
QUOTATION_SYNC_BACKOFF_SECONDS=60
QUOTATION_SYNC_BATCH_SIZE=10
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_HMAC_SECRET=
